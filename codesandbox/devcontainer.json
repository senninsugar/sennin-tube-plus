{
  "name": "TokyoNOW!tube",
  "image": "python:3.11-slim",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    }
  },
  "postCreateCommand": "pip install -r requirements.txt",
  "forwardPorts": [1024],
  "portsAttributes": {
    "1024": {
      "label": "TokyoNOW!tube",
      "onAutoForward": "openPreview"
    }
  },
  "remoteEnv": {
    "PYTHONUNBUFFERED": "1"
  }
}
